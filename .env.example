# The Scenes local development configuration.
# Copy to .env.local (ignored by Git). Hosted pre-production values belong only in the separate,
# ignored .env.staging.local file; never place production credentials here.

# `fixtures` keeps the accepted Phase 2 app independent of a backend.
# Use `supabase-local` only while the local Supabase stack is running.
VITE_DATA_MODE=fixtures

# The next two variables are ignored and not initialized in fixture mode. They become mandatory only
# for a connected mode. This example intentionally documents the local stack only.
# `supabase-local` must reject hosted/non-loopback URLs.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Replace only in .env.local with the local publishable key printed by `bunx supabase start`.
# A publishable key is not a privileged service/secret key; RLS still protects all data.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Intentionally absent: service-role/secret key, database password, hosted project reference.

# ---------------------------------------------------------------------------------------------
# Rate limiting (P4-S2). These are SERVER-ONLY values: never prefix them with VITE_.
# `memory` is the default bounded process-local limiter for fixture/local mode.
RATE_LIMIT_DRIVER=memory
# Connected staging only, after separate approval: set RATE_LIMIT_DRIVER=upstash and provide a
# scoped Upstash REST URL/token plus a >=16-character HMAC secret in the ignored env file or the
# platform secret store. Never commit these values.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_HASH_SECRET=

# ---------------------------------------------------------------------------------------------
# Runtime configuration contract
#
# The server resolves configuration from the merged runtime environment: `process.env` overlaid by
# Cloudflare's `globalThis.__env__` bindings (Nitro's `cloudflare-module` preset assigns them on every
# request). On Cloudflare, set these in the dashboard under Workers → Settings → Variables and
# Secrets. Locally they come from `.env.local`. Binding values win over `process.env`.
#
# A connected mode with missing required values is never silently downgraded to fixtures: the server
# reports `misconfigured` and the root renders a configuration notice that lists variable NAMES only.
# Settings → Account shows the live integration report (names and states, never values).
# ---------------------------------------------------------------------------------------------

# Feedback channel (P4-S4). `memory` is the local preview inbox and is reported `disabled` in a hosted
# deployment. `telegram` delivers to the founder-approved internal chat; an incomplete Telegram
# configuration fails closed and is reported `misconfigured` (it never falls back to memory).
FEEDBACK_PROVIDER=memory
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_FEEDBACK_CHAT_ID=

# Not enabled in this build — reported `disabled`. Adding keys alone does NOT activate them:
#   Web push (P4-S6, needs founder approval + a Cloudflare/workerd proof):
#     VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
#   Application-originated email (Resend):
#     RESEND_API_KEY, EMAIL_FROM
#   Platform object storage (P4-S7, needs a concrete approved object):
#     R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_ENDPOINT
#
# Account email (confirmation and password recovery) is delivered by Supabase Auth custom SMTP and is
# configured in the Supabase dashboard. The application runtime does not read SMTP credentials.
