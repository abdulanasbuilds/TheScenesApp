# ─── Telegram (feedback widget) ───────────────────────────────────────────────
# Fill in real values locally and set the same keys on your Cloudflare dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIVATE_CHAT_ID=

# ─── Paystack (community membership payments) ──────────────────────────────────
# Get your API keys from https://dashboard.paystack.com/#/settings/developers
# VITE_ prefix → safe to ship to the browser (public key only!)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret key → server-side only, never exposed to the browser
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Flutterwave (alternative payment provider) ────────────────────────────────
# Get your API keys from https://developer.flutterwave.com
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (optional real backend — leave blank to use localStorage mode) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
