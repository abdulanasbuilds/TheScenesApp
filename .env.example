# ══════════════════════════════════════════════════════════════════════════════
# SukaSpace — Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT
#   cp .env.example .env
#   Fill in real values, then run:  bun run dev
#
# CLOUDFLARE DEPLOYMENT
#   In your Cloudflare dashboard go to:
#     Workers & Pages → Your project → Settings → Environment Variables
#
#   Add every variable from BOTH sections below.
#
#   ┌─────────────────────────────────────────────────────────────────────────┐
#   │  BUILD-TIME vars (VITE_ prefix)                                         │
#   │  Cloudflare bakes these into your JS bundle during each build.          │
#   │  They are PUBLIC — never put secrets here.                              │
#   │  Set as "Environment Variables" (not Secrets) in Cloudflare.            │
#   └─────────────────────────────────────────────────────────────────────────┘
#
#   ┌─────────────────────────────────────────────────────────────────────────┐
#   │  RUNTIME vars (no VITE_ prefix)                                         │
#   │  Only available in server functions (Workers runtime).                  │
#   │  These are SECRETS — set them as "Secrets" in Cloudflare.              │
#   └─────────────────────────────────────────────────────────────────────────┘
#
# ══════════════════════════════════════════════════════════════════════════════


# ── BUILD-TIME (public, baked into the client JS bundle) ─────────────────────
# Source: https://app.supabase.com → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # "anon public" key — safe for browser

VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx          # Paystack Dashboard → Settings → API Keys

# Your production URL — used in email links and OG tags
VITE_APP_URL=https://yourdomain.com


# ── RUNTIME SERVER SECRETS (never sent to the browser) ───────────────────────
# These are read by Cloudflare Worker server functions at runtime.
# Set each one as a "Secret" in Cloudflare dashboard (not plain variable).

# ─── Supabase (server-side REST calls + admin operations) ────────────────────
# Same values as the VITE_ vars above — needed separately for server functions.
# Source: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co                  # same value as VITE_SUPABASE_URL
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...         # same value as VITE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...      # "service_role" key — bypasses RLS; keep secret!

# ─── Paystack (payment verification) ─────────────────────────────────────────
# Source: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx               # server-only — verifies charges

# ─── Resend (transactional emails) ───────────────────────────────────────────
# Source: https://resend.com/api-keys
# Create a verified domain at https://resend.com/domains first.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@yourdomain.com                             # must match a verified Resend domain

# ─── Telegram (optional — feedback notifications) ────────────────────────────
# Without these, feedback still saves to the Supabase `feedback` table.
# 1. Message @BotFather → /newbot → copy the token
# 2. Add your bot to the target group/chat
# 3. Message @userinfobot in the chat to get the chat ID (negative for groups)
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_PRIVATE_CHAT_ID=-1001234567890

# ─── App URL (server-side, used in email links) ──────────────────────────────
# Same value as VITE_APP_URL — needed separately for server functions.
APP_URL=https://yourdomain.com                                     # same value as VITE_APP_URL
