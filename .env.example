# ══════════════════════════════════════════════════════════════════════════════
# SukaSpace — Environment Variables Reference
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local dev.
# In production (Cloudflare), add every key to your Cloudflare dashboard under
# Workers & Pages → Your Project → Settings → Environment Variables.
#
# VITE_ prefix = safe to send to the browser (public values only)
# No prefix    = server-side only, never exposed to the browser
# ══════════════════════════════════════════════════════════════════════════════


# ─── Supabase (database + auth + realtime) ─────────────────────────────────────
# https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...                        # "anon public" key — safe for browser
SUPABASE_SERVICE_KEY=eyJ...                           # "service_role" key — server-side only, bypasses RLS


# ─── Telegram (feedback & bug reports) ─────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Add your bot to the target chat, then message @userinfobot to get the chat ID
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_PRIVATE_CHAT_ID=-1001234567890              # negative for group chats


# ─── Paystack (community membership payments) ──────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx # public key — safe for browser popup
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx      # server-side only — used to verify charges


# ─── Resend (transactional emails) ─────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@yourdomain.com               # must be a verified Resend domain


# ─── App URL (used in email links) ─────────────────────────────────────────────
# Set to your Cloudflare Pages / custom domain in production
VITE_APP_URL=https://sukaspace.com
