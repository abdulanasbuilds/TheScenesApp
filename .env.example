# The Scenes local development configuration.
# Copy to .env.local (ignored by Git). Hosted pre-production values belong only in the separate,
# ignored .env.staging.local file; never place production credentials here.

# `fixtures` keeps the accepted Phase 2 app independent of a backend.
# Use `supabase-local` only while the local Supabase stack is running.
VITE_DATA_MODE=fixtures

# The next two variables are ignored and not initialized in fixture mode. They become mandatory only
# for a connected mode. This example intentionally documents the local stack only.
# `supabase-local` must reject hosted/non-loopback URLs.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Replace only in .env.local with the local publishable key printed by `bunx supabase start`.
# A publishable key is not a privileged service/secret key; RLS still protects all data.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Intentionally absent: service-role/secret key, database password, hosted project reference.

# ---------------------------------------------------------------------------------------------
# Rate limiting (P4-S2). These are SERVER-ONLY values: never prefix them with VITE_.
# `memory` is the default bounded process-local limiter for fixture/local mode.
RATE_LIMIT_DRIVER=memory
# Connected staging only, after separate approval: set RATE_LIMIT_DRIVER=upstash and provide a
# scoped Upstash REST URL/token plus a >=16-character HMAC secret in the ignored env file or the
# platform secret store. Never commit these values.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_HASH_SECRET=
