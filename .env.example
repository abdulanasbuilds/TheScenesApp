# ══════════════════════════════════════════════════════════════════════════════
# SukaSpace — Environment Variables Reference
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local dev.
# In production (Cloudflare), add every key to your Cloudflare dashboard under
# Workers & Pages → Your Project → Settings → Environment Variables.
#
# VITE_ prefix = safe to send to the browser (public values only)
# No prefix    = server-side only, never exposed to the browser
# ══════════════════════════════════════════════════════════════════════════════


# ─── Supabase (database + auth + realtime) ─────────────────────────────────────
# https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...                        # "anon public" key — safe for browser
# Accept both spellings during transition (code reads SERVICE_ROLE_KEY first)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                     # "service_role" key — server-only, bypasses RLS
SUPABASE_SERVICE_KEY=eyJ...                          # alias — only needed if you used the old name


# ─── Telegram (feedback & bug reports) ─────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Add your bot to the target chat, then message @userinfobot to get the chat ID
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_PRIVATE_CHAT_ID=-1001234567890              # negative for group chats


# ─── Paystack (community payments + creator payouts) ───────────────────────────
# https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx # public key — safe for browser popup
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx      # server-only — used to verify charges
# Webhook secret: Dashboard → Settings → API Keys & Webhooks → Webhook URL → copy secret
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx    # HMAC-SHA512 signing secret from Paystack dashboard


# ─── Resend (transactional emails) ─────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@yourdomain.com               # must be a verified Resend domain


# ─── Cloudflare R2 (file storage — Pro plan only) ─────────────────────────────
# https://dash.cloudflare.com → R2 → Create bucket
# Then: R2 → Manage R2 API Tokens → Create Token (Object Read & Write)
CLOUDFLARE_ACCOUNT_ID=abc123def456                   # found in Cloudflare dashboard URL
CLOUDFLARE_R2_BUCKET_NAME=sukaspace-assets           # your bucket name
CLOUDFLARE_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx     # from R2 API token
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Bunny.net (video streaming — Pro plan only) ───────────────────────────────
# https://panel.bunny.net → Stream → Libraries → Create Library
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ─── Redis (rate limiting — Upstash REST API) ──────────────────────────────────
# https://console.upstash.com → Create Database → REST API section
# If not set, rate limiting degrades gracefully (logs a warning, allows through)
REDIS_URL=https://your-redis.upstash.io
REDIS_TOKEN=AXxx...                                  # Upstash REST API token


# ─── Monetization fees (change without redeploying by updating env vars) ───────
# All fees are in basis points (bps): 100 bps = 1%, 700 bps = 7%
# All amounts are in the smallest currency unit (kobo/cents)

# Platform fees
FREE_PLAN_PLATFORM_FEE_BPS=700                       # 7% fee on Free plan (default)
PRO_PLAN_PLATFORM_FEE_BPS=0                          # 0% fee on Pro plan (default)

# Pro plan subscription price (USD cents — 4900 = $49.00)
PRO_PLAN_PRICE_CENTS=4900

# Pro plan R2 storage quota (bytes — 107374182400 = 100 GB)
PRO_PLAN_STORAGE_BYTES=107374182400

# Free plan storage (0 = no hosted storage, use external embeds)
FREE_PLAN_STORAGE_BYTES=0

# Withdrawal settings
# Instant withdrawal fixed fee in smallest currency unit (10000 = ₦100)
WITHDRAWAL_FIXED_FEE_CENTS=10000
# Instant withdrawal percentage fee in basis points (100 = 1%)
WITHDRAWAL_PERCENT_FEE_BPS=100
# Minimum withdrawal amount in smallest currency unit (500000 = ₦5,000)
MIN_WITHDRAWAL_AMOUNT_CENTS=500000


# ─── App URL (used in email links + presigned URL validation) ──────────────────
# Set to your Cloudflare Pages / custom domain in production
APP_URL=https://sukaspace.com
VITE_APP_URL=https://sukaspace.com
